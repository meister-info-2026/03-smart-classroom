# Vision Client Environment Variables Template

# FastAPI Backend URL (Local PC)
BACKEND_URL=http://localhost:8000

# Device Authentication Key (Must match backend DEVICE_API_KEY)
DEVICE_API_KEY=your_secret_device_api_key_here

# Camera Index — this team uses two cameras (entry auth + classroom seat/occupancy)
ENTRY_CAMERA_INDEX=0
CLASSROOM_CAMERA_INDEX=1
